# PostgreSQL connection. Leave unset to run on typed seed data.
# Leads then persist to data/leads.json (or memory if the disk is read-only).
DATABASE_URL="postgresql://aurelia:aurelia@localhost:5432/aurelia?schema=public"

# Required in production to open /admin. In development, empty falls back to "aurelia".
ADMIN_PASSWORD=""

# Optional. When both are set, new enquiries are posted to this Telegram chat.
# Never commit real tokens.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Set to 1 to skip `prisma db push` during `npm start`.
SKIP_DB_PUSH=""
